# ==============================================================================
# Google Apps Script & Clasp Configuration
# ==============================================================================

# Script ID dari Google Apps Script (Project Settings > IDs > Script ID)
# Salin nilai ini ke properti "scriptId" pada file .clasp.json sebelum menjalankan clasp push
CLASP_SCRIPT_ID=your_script_id_here

# ==============================================================================
# Script Properties (Google Workspace Environment Variables)
# Konfigurasikan pada Apps Script: Project Settings > Script Properties
# ==============================================================================
SPREADSHEET_ID=your_google_spreadsheet_id_here
ROOT_FOLDER_ID=your_root_folder_id_here
TEMPLATES_FOLDER_ID=your_templates_folder_id_here
SIGNATURES_FOLDER_ID=your_signatures_folder_id_here
LETTERS_FOLDER_ID=your_letters_folder_id_here
